# hyphae environment configuration.
#
# Copy this file to `.env` and fill in your values:
#     cp .env.example .env
#
# Pydantic Settings reads this file lazily during application startup without
# copying values into os.environ. Real process variables take precedence, so
# the same .env works for local dev, containers, and CI.

# --- LLM provider keys ------------------------------------------------------
# Set keys for every provider used by active models.yaml rows, plus the direct
# LLM_PROVIDER fallback when applicable. One process may use multiple providers.
GEMINI_API_KEY=
# Reserved for future compatibility; no Anthropic provider is implemented.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Base URL for an OpenAI-compatible endpoint (e.g. local Ollama). Empty
# targets real OpenAI.
OPENAI_COMPAT_BASE_URL=

# --- LLM selection ---------------------------------------------------------
LLM_PROVIDER=openai_compatible
LLM_MODEL=ornith-1.0-9b
LLM_MAX_TOKENS=4096

# --- Agent-loop reliability ------------------------------------------------
LLM_TIMEOUT_SECONDS=120
TOOL_TIMEOUT_SECONDS=60
# Bounds transport open, protocol initialization, and tool discovery as one MCP
# catalog-discovery or turn-lease operation. <=0 disables the connection bound.
MCP_CONNECT_TIMEOUT_SECONDS=30
# Age after which an accepted request refreshes an MCP catalog before routing.
# <=0 disables age-driven refresh; startup and turn-lease discovery still run.
MCP_CATALOG_TTL_SECONDS=300
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=0.5
TOOL_RESULT_MAX_CHARS=20000
LOOP_MAX_ITERATIONS=10

# --- Bounded & safe runs -----------------------------------------------------
# Independent stop conditions on top of LOOP_MAX_ITERATIONS. Each is <=0
# disabled by default; set a value to opt in. See docs/configuration.md.
RUN_MAX_TOKENS=0
RUN_MAX_SECONDS=0
ABORT_AFTER_CONSECUTIVE_TOOL_FAILURES=0

# --- Context assembly --------------------------------------------------------
# How the agent loop shapes the outgoing message view per LLM call.
# naive = pass-through, but reject an over-budget request before the provider;
# compaction = summarize the
# over-budget middle, keep the task header + recent tail verbatim. Budget =
# context_window (per-model in models.yaml, else the default below) - max
# output tokens - safety margin. See docs/configuration.md.
CONTEXT_STRATEGY=naive
CONTEXT_DEFAULT_WINDOW_TOKENS=32768
CONTEXT_SAFETY_MARGIN_TOKENS=1024
CONTEXT_RECENT_MESSAGES=6
CONTEXT_SUMMARY_MAX_TOKENS=512

# --- Session store ---------------------------------------------------------
SESSION_TTL_SECONDS=3600
SESSION_CAPACITY=1000
SESSION_HISTORY_MAX_CHARS=256000

# --- Orchestration ---------------------------------------------------------
ORCHESTRATION_ENABLED=true
# Override which model the orchestrator itself uses; empty = default from models.yaml
ORCHESTRATOR_MODEL_ID=

# --- Config file paths (relative paths resolve from the repository root) -----
MCP_CONFIG_PATH=hyphae/config/mcp_config.yaml
MODELS_CONFIG_PATH=hyphae/config/models.yaml
ORCHESTRATOR_PROMPT_PATH=hyphae/config/orchestrator_prompt.md
AGENT_PROMPT_PATH=hyphae/config/agent_prompt.md

# OpenAI-compatible streaming reasoning and tool activity. "reasoning" emits
# reasoning plus compact status lines; "reasoning_full" also displays bounded
# arguments and results; "hidden" omits the optional reasoning_content channel.
OPENAI_COMPAT_TOOL_ACTIVITY_MODE=reasoning
# Presentation threshold for arguments or results in "reasoning_full" mode.
#OPENAI_COMPAT_TOOL_ACTIVITY_MAX_CHARS=2000

# --- API authentication ----------------------------------------------------
# Optional API-key gate on /chat, /chat/stream, and /v1/* (/health stays open).
# Empty = auth off (single-operator dev default). Set a value to require it;
# clients send `X-API-Key: <key>` or `Authorization: Bearer <key>`. For the
# OpenWebUI -> /v1 path, set this key in the OpenAI connection config there.
HYPHAE_API_KEY=

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO

# --- Observability (run tracing) -------------------------------------------
# When true, the loop serializes its emitted event stream to JSONL (one record
# per event, tagged with run_id + step + timestamp + latency). Event payloads
# can include output/reasoning text, routing selections, tool arguments and
# results, usage, and errors. It does not independently serialize the complete
# incoming prompt, system prompt, or history, but the file remains sensitive.
# HYPHAE_API_KEY protects HTTP calls, not this file; guard it at the filesystem
# level. Retention is fixed at one 10 MiB active file plus three backups.
TRACE_ENABLED=false
TRACE_JSONL_PATH=traces/harness.jsonl

# --- MCP server endpoint/interpolation examples ----------------------------
# The checked-in hyphae/config/mcp_config.yaml references only OPEN_WEBSEARCH_URL.
OPEN_WEBSEARCH_URL=http://localhost:3000/mcp
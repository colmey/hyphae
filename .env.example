# PyAiHarness environment configuration.
#
# Copy this file to `.env` and fill in your values:
#     cp .env.example .env
#
# `bootstrap.load_secrets()` loads `.env` into os.environ at startup. Real
# environment variables already set in the process take precedence over the
# values here, so the same .env works for local dev, containers, and CI.

# --- LLM provider keys (set the one matching LLM_PROVIDER) ------------------
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Base URL for an OpenAI-compatible endpoint (e.g. local Ollama). Empty
# targets real OpenAI.
OPENAI_BASE_URL=

# --- LLM selection ---------------------------------------------------------
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3-flash-preview
LLM_MAX_TOKENS=4096

# --- Agent-loop reliability ------------------------------------------------
LLM_TIMEOUT_SECONDS=120
TOOL_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=0.5
TOOL_RESULT_MAX_CHARS=20000
MAX_LOOP_ITERATIONS=25

# --- Bounded & safe runs -----------------------------------------------------
# Independent stop conditions on top of MAX_LOOP_ITERATIONS. Each is <=0
# disabled by default; set a value to opt in. See docs/configuration.md.
MAX_RUN_TOKENS=0
MAX_RUN_SECONDS=0
ABORT_AFTER_CONSECUTIVE_TOOL_FAILURES=0

# --- Context assembly --------------------------------------------------------
# How the agent loop shapes the outgoing message view per LLM call.
# naive = pass-through (over budget only warns); compaction = summarize the
# over-budget middle, keep the task header + recent tail verbatim. Budget =
# context_window (per-model in models.yaml, else the default below) - max
# output tokens - safety margin. See docs/configuration.md.
CONTEXT_STRATEGY=naive
CONTEXT_DEFAULT_WINDOW_TOKENS=32768
CONTEXT_SAFETY_MARGIN_TOKENS=1024
CONTEXT_RECENT_MESSAGES=6
CONTEXT_SUMMARY_MAX_TOKENS=512

# --- Session store ---------------------------------------------------------
SESSION_TTL_SECONDS=3600
SESSION_MAX_COUNT=1000

# --- Orchestration ---------------------------------------------------------
ORCHESTRATION_ENABLED=true
# Override which model the orchestrator itself uses; empty = default from models.yaml
ORCHESTRATOR_MODEL_ID=

# --- Config file paths (override only for custom deployments) ---------------
MCP_CONFIG_PATH=config/mcp_config.yaml
MODELS_CONFIG_PATH=config/models.yaml
ORCHESTRATOR_PROMPT_PATH=config/orchestrator_prompt.md

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO

# --- Observability (run tracing) -------------------------------------------
# When true, the loop serializes its event stream to a JSONL trace (one record
# per event, tagged with run_id + step + timestamp + latency). Off by default.
# The trace captures full prompts, tool args, and tool results -- treat the
# file as sensitive (no auth on the harness yet).
TRACE_ENABLED=false
TRACE_PATH=traces/harness.jsonl

# --- MCP server endpoints (referenced by config/mcp_config.yaml) -----------
GOOGLE_TOOLBOX_URL=http://localhost:5002/mcp
OPEN_WEBSEARCH_URL=http://localhost:5003/sse

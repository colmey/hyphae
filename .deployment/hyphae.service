# Hyphae systemd service
#
# Render, install, and start (run as the normal user from the repository root):
#   ./scripts/install.sh
#
# Inspect status and follow logs:
#   sudo systemctl status hyphae
#   journalctl -u hyphae.service -f
#
# Stop and remove automatically:
#   ./scripts/uninstall.sh
#
# Equivalent manual removal commands:
#   sudo systemctl disable --now hyphae
#   sudo rm /etc/systemd/system/hyphae.service
#   sudo systemctl daemon-reload
#   sudo systemctl reset-failed hyphae

[Unit]
Description=Hyphae
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={USER}
WorkingDirectory={ROOT}
ExecStart={ROOT}/.venv/bin/uvicorn hyphae.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
